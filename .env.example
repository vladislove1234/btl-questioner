# Google Apps Script web app URL (Deploy → Manage deployments → Web app URL).
# npm run deploy builds with these values, so fill them in before deploying.
VITE_SUBMIT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Must match SUBMIT_TOKEN in the Apps Script project's Script Properties.
# It ships in the client bundle, so it only keeps out casual spam. It is not a real secret.
VITE_SUBMIT_TOKEN=change-me

# Seconds of inactivity before a half-finished session resets to the Intro.
VITE_IDLE_RESET_SECONDS=90
